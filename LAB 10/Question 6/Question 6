#include <stdio.h>
#include <string.h>

int main(){
    char username[50];
    char password[50];

    char savedUser[50];
    char savedPassword[50];

    FILE *fptr;

    printf("Enter Username:");
    scanf("%49s",username);

    printf("Enter Password:");
    scanf("%49s",password);

    fptr=fopen("credentials.txt","r");

    if(fptr==NULL){
        printf("Error Opening Credentials file\n");
    }
    else{
        if(fscanf(fptr,"%49s %49s",savedUser,savedPassword)==2)
        {
            if(strcmp(username,savedUser)==0 && strcmp(password, savedPassword)==0){
                printf("\nAccess Granted\n");
            }
        else
        {
            printf("\nAccess Denied\n");
        }
        }
    else {
        printf("Invalid credentials file\n");

    }
    fclose(fptr);
    }
return 0;
}