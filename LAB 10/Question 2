#include <stdio.h>
#include <string.h>

int main(){
    int names[10][50];
    int temp[100];
    int i,j;

    printf("Enter 10 Student Names:\n");
    for(i=0;i<10;i++)
    {
        printf("Name %d: ",i+1);
        scanf("%s", names[i]);
    }
    //Bubble sort algorithm
    for(i=0;i<10;i++)
    {
        for(j=i+1;j<10;j++)
        {
            if(strcmp(names[i],names[j])>0)
            {
                strcpy(temp,names[i]);
                strcpy(names[i],names[j]);
                strcpy(names[j],temp);
            }
        }
    }
    printf("\nNames in Alphabetical Order:\n");

    for (i = 0; i < 10; i++)
    {
        printf("%s\n", names[i]);
    }

    return 0;
}


