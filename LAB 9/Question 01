#include <stdio.h>
 
float calculateDiscount(float amount,char type){
    float rate ;

    if(type == 'P'|| type == 'p'){
        rate=20;
    } else if(type == 'G'|| type == 'g'){
        rate=10;
    } else {
        rate=5;
    }
    if(amount > 10000){
        rate =rate+2 ;
    }
    return amount*rate/100;
}
float calculateFinalBill(float amount){
    float tax,shipping;

    tax=amount*15/100;
    if(amount<=5000){
        shipping=300;
    } else {
        shipping=0;
    }
    return amount+tax+shipping;
    
}
int main(){
    float amount,discount,discountAmount,finalBill;
    char type;

    printf("Enter the amount: ");
    scanf("%f",&amount);
    printf("Enter the type (P/G): ");
    scanf(" %c",&type);

    discount=calculateDiscount(amount,type);
    discountAmount=amount-discount;
    finalBill=calculateFinalBill(discountAmount);

    printf("Discount: %.2f\n",discount);
    printf("Discounted Amount: %.2f\n",discountAmount);
    printf("Final Bill: %.2f\n",finalBill);

    return 0;
}



