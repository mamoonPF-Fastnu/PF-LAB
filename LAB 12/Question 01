#include <stdio.h>
#include <stdlib.h>

int main(){
    int n,i;
    int total=0;
    int lowestIndex=0;
    int updateIndex,newStock;
    float average;
    int p;


    printf("Enter Number of Book Category:");
    scanf("%d",&n);

    if(n<=0){
        printf("Invalid Category");
        return 1;
    }

    int *stock=(int*)malloc(n*sizeof(int));
    if(stock==NULL){
        printf("Memory Allocation Failed\n");
        return 1;
}
for(i=0;i<n;i++){
    p=i+1;
printf("Enter the Stock for Category %d :\n",p);
scanf("%d",&stock[i]);}

for(i=0;i<n;i++){
    total=total+stock[i];
}
average=(float)total/n;
for(i=0;i<n;i++);{
    if (stock[i]<stock[lowestIndex]){
        lowestIndex=i;
    }
}
printf("Stock Report\n");
printf("Total Stock : %d\n",total);
printf("Lowest Stock Cateory Index: %d",lowestIndex+1);
printf("Lowest Stock quanity : %d\n",stock[lowestIndex]);

printf("Enter the Cateogry Number you want to Update:\n");
scanf("%d",&updateIndex);

if(updateIndex>=1 && updateIndex<=n){
    printf("Enter the new updated stock quantity:\n");
    scanf("%d",&newStock);

    stock[updateIndex-1]=newStock;
    for(i=0;i<n;i++){
    printf("Category %d : %d\n",p,stock[i]);
}
free(stock);
printf("Memeroy Released\n");
return 0;
}}
