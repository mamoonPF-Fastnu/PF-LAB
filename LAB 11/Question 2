#include <stdio.h>

struct Product{
    int id;
    char name[50];
    char category[50];
    float price;
    int stockQuantity;
};
void displayProductDetail(struct Product p){
    float discount=p.price*0.05f;
    float finalPrice=p.price-discount;

    printf("Product ID:%d\n",p.id);
    printf("Product Name:%s\n",p.name);
    printf("Catergory:%s\n",p.category);
    printf("Original Price:$%.2f\n",p.price);
    printf("Stock Quantity: %d\n",p.stockQuantity);
    printf("Discount (5%%):$-%.2f\n",discount);
    printf("Final Price:%.2f\n",finalPrice);

}
int main(){
    struct Product product1={101,"Wireless Headphones","Electronics",89.99,45};
    struct Product product2={102,"Ergonomic Keyboard","Electronic",120.00,20};
    
    displayProductDetail(product1);
    displayProductDetail(product2);

    return 0;

}